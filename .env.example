# Alpaca IEX live data and news. Keep real values on your computer and out of Git.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# SEC requires an identifying User-Agent for automated requests.
SEC_USER_AGENT=X20 Market Lens contact@example.com

# Optional starting values for the position form.
X20_SHARES=0
X20_ENTRY_PRICE=0
X20_PORTFOLIO_VALUE=10000
X20_RISK_AVERSION=0.65
X20_MAX_LOSS_PCT=0.08
X20_HORIZON_DAYS=20
