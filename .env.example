# Required for Alpaca IEX live market data and news.
# Keep these in the local environment. Never commit real values.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# SEC asks automated clients to identify themselves.
SEC_USER_AGENT=X20 Market Lens contact@example.com

# Optional initial personal profile (editable in the dashboard).
X20_SHARES=0
X20_ENTRY_PRICE=0
X20_PORTFOLIO_VALUE=10000
X20_RISK_AVERSION=0.65
X20_MAX_LOSS_PCT=0.08
X20_HORIZON_DAYS=20
